# Example environment file. Copy to .env and fill values from Lovable Cloud / project settings.
# DO NOT commit the real .env — it is git-ignored.

# Backend (Lovable Cloud / Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-visible (Vite injects these at build time — never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Third-party data providers (server-only — keep out of the browser bundle)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=
TWELVE_DATA_API_KEY=
MARKETAUX_API_TOKEN=

# Cron / scheduler shared secret (optional; protects /api/public/cron/* endpoints)
CRON_SECRET=

# Lovable AI Gateway
LOVABLE_API_KEY=
